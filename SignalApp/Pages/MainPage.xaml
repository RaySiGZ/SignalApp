<Page x:Class="SignalApp.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SignalApp.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Основная страница"
      Cursor="Arrow">

   <Page.Resources>
      <Style TargetType="TextBox">
         <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
               <Setter Property="BorderBrush" Value="Red"/>
               <Setter Property="ToolTip"
                       Value="{Binding RelativeSource={RelativeSource Self},
                                          Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
         </Style.Triggers>
      </Style>
   </Page.Resources>

   <Grid>
      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,44,0,0">
         <Button x:Name="SaveFolderButton" Content="Папка сохранения" Height="20" Click="SaveFolderButton_Click" Cursor="Hand"/>
         <TextBlock x:Name="SavePath" TextWrapping="Wrap" Text="../saveFolder" Height="15" RenderTransformOrigin="0.5,0.5" IsEnabled="False">
            <TextBlock.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="5"/>
               </TransformGroup>
            </TextBlock.RenderTransform>
         </TextBlock>
      </StackPanel>
      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,94,0,0">
         <TextBlock TextWrapping="Wrap" Text="Частота" Cursor="Arrow" RenderTransformOrigin="0.5,0.5" Height="15">
            <TextBlock.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="0"/>
               </TransformGroup>
            </TextBlock.RenderTransform>
         </TextBlock>

         <TextBox x:Name="FrequencyBox"
                  TextWrapping="Wrap"
                  Width="120"
                  Cursor="IBeam"
                  RenderTransformOrigin="0.5,0.5"
                  UndoLimit="3" Height="20" Text="{Binding Frequency, NotifyOnValidationError=True, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}">
            <TextBox.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="36"/>
               </TransformGroup>
            </TextBox.RenderTransform>
         </TextBox>
      </StackPanel>

      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,119,0,0">
         <TextBlock TextWrapping="Wrap" Text="Амплитуда" Cursor="Arrow" RenderTransformOrigin="0.5,0.5" Height="15">
            <TextBlock.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="0"/>
               </TransformGroup>
            </TextBlock.RenderTransform>
         </TextBlock>

         <TextBox x:Name="AmplitudeBox"
                  TextWrapping="Wrap"
                  Width="120"
                  UndoLimit="5"
                  Cursor="IBeam"
                  RenderTransformOrigin="0.5,0.5" Height="20" Text="{Binding Amplitude, NotifyOnValidationError=True, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}">
            <TextBox.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="19"/>
               </TransformGroup>
            </TextBox.RenderTransform>
         </TextBox>
      </StackPanel>

      <TextBlock HorizontalAlignment="Left" Margin="10,144,0,0" TextWrapping="Wrap" Text="Количество точек" VerticalAlignment="Top" IsEnabled="False" Cursor="Arrow" Height="15"/>

      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,165,0,0">
         <TextBlock TextWrapping="Wrap" Cursor="Arrow" RenderTransformOrigin="0.5,0.5" IsEnabled="False" Height="15">
            <TextBlock.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="0"/>
               </TransformGroup>
            </TextBlock.RenderTransform><Run Language="ru-ru" Text="Всего"/></TextBlock>

         <TextBox x:Name="MaxCountBox"
                  TextWrapping="Wrap"
                  Width="120"
                  UndoLimit="5"
                  Cursor="IBeam"
                  RenderTransformOrigin="0.5,0.5" Height="20" Text="{Binding MaxCount, NotifyOnValidationError=True, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}">
            <TextBox.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="48"/>
               </TransformGroup>
            </TextBox.RenderTransform>
         </TextBox>
      </StackPanel>

      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,190,0,0">
         <TextBlock TextWrapping="Wrap" Cursor="Arrow" RenderTransformOrigin="0.5,0.5" IsEnabled="False" Height="15">
            <TextBlock.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="0"/>
               </TransformGroup>
            </TextBlock.RenderTransform><Run Language="ru-ru" Text="В периоде"/></TextBlock>

         <TextBox x:Name="PeriodCountBox"
                  TextWrapping="Wrap"
                  Width="120"
                  UndoLimit="5"
                  Cursor="IBeam"
                  RenderTransformOrigin="0.5,0.5" Height="20" Text="{Binding PeriodCount, NotifyOnValidationError=True, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}">
            <TextBox.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="21"/>
               </TransformGroup>
            </TextBox.RenderTransform>
         </TextBox>
      </StackPanel>
      <StackPanel HorizontalAlignment="Left" Margin="10,15,0,0" Orientation="Horizontal" VerticalAlignment="Top" Width="339">
         <TextBlock TextWrapping="Wrap" Text="Тип графика" Height="15"/>
         <ComboBox x:Name="GrafTypeComboBox" Width="120" Height="24" RenderTransformOrigin="0.5,0.5" Cursor="Hand" DisplayMemberPath="Display" SelectedValuePath="Value">
            <ComboBox.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="10"/>
               </TransformGroup>
            </ComboBox.RenderTransform>
         </ComboBox>
         <Button x:Name="ShowGrafButton" Content="Отобразить график" Height="20" RenderTransformOrigin="0.5,0.5" Cursor="Hand" Click="ShowGrafButton_Click">
            <Button.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="25"/>
               </TransformGroup>
            </Button.RenderTransform>
         </Button>
      </StackPanel>
      <StackPanel Margin="10,69,0,0" Orientation="Horizontal" Height="20" VerticalAlignment="Top">
         <Button x:Name="SaveButton" Content="Сохранить" RenderTransformOrigin="0.5,0.5" Cursor="Hand" Click="SaveButton_Click" Height="20" Width="64"/>
         <Button x:Name="SaveAllButton" Content="Сохранить все" RenderTransformOrigin="0.5,0.5" Cursor="Hand" Click="SaveAllButton_Click" Height="20" Width="85">
            <Button.RenderTransform>
               <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform X="14"/>
               </TransformGroup>
            </Button.RenderTransform>
         </Button>
      </StackPanel>
   </Grid>
</Page>